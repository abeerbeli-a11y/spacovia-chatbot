ANTHROPIC_API_KEY=your-api-key-here
PORT=3001
ALLOWED_ORIGIN=https://your-dads-website.com

# Admin dashboard (at /admin) — lets you edit the bot's knowledge, read
# conversations, and set usage caps without touching code.
ADMIN_PASSWORD=choose-a-strong-password
# Random signing secret for admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=generate-a-random-64-char-hex-string
